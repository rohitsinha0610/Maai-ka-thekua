# ---------------------------------------------------------------
# Maai Ka Thekuaa - environment configuration
#
# Copy this file to ".env" and edit it. Never commit the real .env.
# Every value here has a safe default, so the app also runs without it.
# ---------------------------------------------------------------

# --- Server -----------------------------------------------------
# Most hosts set PORT themselves; leave it as is unless you run locally.
PORT=3000
# 0.0.0.0 is required on a server. Use 127.0.0.1 only for local-only access.
HOST=0.0.0.0
# "production" hides the demo login hint and shortens error messages.
NODE_ENV=development
# Public address of the site, used in console output. e.g. https://maaikathekuaa.com
BASE_URL=

# --- Storage ----------------------------------------------------
# Everything the app writes lives here: database, uploaded images, backups.
# On a host with a mounted volume, point this at the volume (e.g. /data).
DATA_DIR=data
# Optional overrides if you want them somewhere else.
# DB_FILE=data/store.db
# UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=5

# --- Security ---------------------------------------------------
# Long random string used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret-string
SESSION_HOURS=72
# Behind Nginx / a platform load balancer, keep TRUST_PROXY on so the app
# can see the real client IP and whether the request arrived over HTTPS.
TRUST_PROXY=true
# Always mark the session cookie Secure (recommended once you have HTTPS).
SECURE_COOKIES=false
# Redirect http:// to https:// (only works when TRUST_PROXY is on).
FORCE_HTTPS=false

# --- First run --------------------------------------------------
# The admin account is created once, on the very first start.
ADMIN_EMAIL=admin@maaikathekuaa.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Set to false to start with an empty catalogue instead of demo products.
SEED_DEMO=true

# --- Payment gateway (optional, read on the server only) --------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
